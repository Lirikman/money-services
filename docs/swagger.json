{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "API-service currency-wallet",
        "title": "Swagger Documentation API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api/v1",
    "paths": {
        "/balance": {
            "get": {
                "description": "Returns the current balance of the user based on their ID from the authorization token.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Getting a user's balance",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Authorization token (Bearer \u003ctoken\u003e)",
                        "name": "Authorization",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful balance receipt",
                        "schema": {
                            "$ref": "#/definitions/services_gw-currency-wallet_delivery.BalanceResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid request or missing user ID",
                        "schema": {
                            "$ref": "#/definitions/services_gw-currency-wallet_delivery.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/services_gw-currency-wallet_delivery.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/exchange": {
            "post": {
                "description": "Converts the specified amount from one currency to another within the user's wallet",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Currency exchange",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Authorization token (Bearer \u003ctoken\u003e)",
                        "name": "Authorization",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "Exchange details (amount, from which currency, to which)",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/services_gw-currency-wallet_delivery.exchangeReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The exchange was successfully completed",
                        "schema": {
                            "$ref": "#/definitions/services_gw-currency-wallet_delivery.ExchangeResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid request format, invalid currencies, or insufficient funds",
                        "schema": {
                            "$ref": "#/definitions/services_gw-currency-wallet_delivery.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/services_gw-currency-wallet_delivery.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/exchange/rates": {
            "get": {
                "description": "Returns current currency exchange rates",
                "produces": [
                    "application/json"
                ],
                "summary": "Obtaining exchange rates",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Authorization token (Bearer \u003ctoken\u003e)",
                        "name": "Authorization",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successfully receiving exchange rates",
                        "schema": {
                            "$ref": "#/definitions/services_gw-currency-wallet_delivery.GetRateResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/services_gw-currency-wallet_delivery.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/login": {
            "post": {
                "description": "Authenticates a user with a username and password, returning a JWT token.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "User authorization",
                "parameters": [
                    {
                        "description": "Login details",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/services_gw-currency-wallet_delivery.authReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful authorization (returns token)",
                        "schema": {
                            "$ref": "#/definitions/services_gw-currency-wallet_delivery.LoginResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid request body format",
                        "schema": {
                            "$ref": "#/definitions/services_gw-currency-wallet_delivery.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Incorrect username or password",
                        "schema": {
                            "$ref": "#/definitions/services_gw-currency-wallet_delivery.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/register": {
            "post": {
                "description": "Creates a new user account using name, email, and password.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Create a new user",
                "parameters": [
                    {
                        "description": "Registration details",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/services_gw-currency-wallet_delivery.authReq"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Successful registration",
                        "schema": {
                            "$ref": "#/definitions/services_gw-currency-wallet_delivery.RegisterResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid data format or user already exists",
                        "schema": {
                            "$ref": "#/definitions/services_gw-currency-wallet_delivery.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/services_gw-currency-wallet_delivery.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/wallet/deposit": {
            "post": {
                "description": "Tops up the user's balance with the specified amount in the selected currency (supports: USD, EUR, RUB).",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Balance replenishment",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Authorization token (Bearer \u003ctoken\u003e)",
                        "name": "Authorization",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "Details for replenishment (amount and currency)",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/services_gw-currency-wallet_delivery.walletReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Balance has been successfully replenished",
                        "schema": {
                            "$ref": "#/definitions/services_gw-currency-wallet_delivery.DeptWithResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid request format, negative amount, or invalid currency",
                        "schema": {
                            "$ref": "#/definitions/services_gw-currency-wallet_delivery.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/services_gw-currency-wallet_delivery.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/wallet/withdraw": {
            "post": {
                "description": "Writes off the specified amount in the selected currency from the user's balance",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Withdrawal of funds",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Authorization token (Bearer \u003ctoken\u003e)",
                        "name": "Authorization",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "Withdrawal details (amount and currency)",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/services_gw-currency-wallet_delivery.walletReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Funds have been successfully withdrawn",
                        "schema": {
                            "$ref": "#/definitions/services_gw-currency-wallet_delivery.DeptWithResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid request format, negative amount, invalid currency, or insufficient funds",
                        "schema": {
                            "$ref": "#/definitions/services_gw-currency-wallet_delivery.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/services_gw-currency-wallet_delivery.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "services_gw-currency-wallet_delivery.BalanceResponse": {
            "type": "object",
            "properties": {
                "balance": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    },
                    "example": {
                        "EUR": "100.00",
                        "RUB": "3000.00",
                        "USD": "500.00"
                    }
                }
            }
        },
        "services_gw-currency-wallet_delivery.DeptWithResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "deposit successful or withdrawal successful"
                },
                "new_balance": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    },
                    "example": {
                        "EUR": "100.00",
                        "RUB": "3000.00",
                        "USD": "500.00"
                    }
                }
            }
        },
        "services_gw-currency-wallet_delivery.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "operation failed"
                }
            }
        },
        "services_gw-currency-wallet_delivery.ExchangeResponse": {
            "type": "object",
            "properties": {
                "exchanged_amount": {
                    "type": "number",
                    "example": 300
                },
                "message": {
                    "type": "string",
                    "example": "currency exchange successful"
                },
                "new_balance": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    },
                    "example": {
                        "EUR": "100.00",
                        "RUB": "3000.00",
                        "USD": "500.00"
                    }
                }
            }
        },
        "services_gw-currency-wallet_delivery.GetRateResponse": {
            "type": "object",
            "properties": {
                "rates": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "number",
                        "format": "float32"
                    },
                    "example": {
                        "EUR/USD": 0.12,
                        "RUB/USD": 0.1,
                        "USD/EUR": 0.02,
                        "USD/RUB": 1.12
                    }
                }
            }
        },
        "services_gw-currency-wallet_delivery.LoginResponse": {
            "type": "object",
            "properties": {
                "token": {
                    "type": "string",
                    "example": "JWT_TOKEN"
                }
            }
        },
        "services_gw-currency-wallet_delivery.RegisterResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "User registered successfully"
                }
            }
        },
        "services_gw-currency-wallet_delivery.authReq": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "example": "ivani_iv123@ya.ru"
                },
                "password": {
                    "type": "string",
                    "example": "SeCrEtS-New902!"
                },
                "username": {
                    "type": "string",
                    "example": "ivan_ivanov"
                }
            }
        },
        "services_gw-currency-wallet_delivery.exchangeReq": {
            "type": "object",
            "properties": {
                "amount": {
                    "type": "number",
                    "example": 300
                },
                "from_currency": {
                    "type": "string",
                    "example": "USD"
                },
                "to_currency": {
                    "type": "string",
                    "example": "RUB"
                }
            }
        },
        "services_gw-currency-wallet_delivery.walletReq": {
            "type": "object",
            "properties": {
                "amount": {
                    "type": "number",
                    "example": 3500
                },
                "currency": {
                    "type": "string",
                    "example": "USD"
                }
            }
        }
    }
}